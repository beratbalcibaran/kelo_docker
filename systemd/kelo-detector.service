[Unit]
Description=KELO object detector (TensorRT GPU)
After=network.target docker.service

[Service]
User=baran
WorkingDirectory=/home/baran/Desktop/kelo_docker/data/models
Environment=PYTHONPATH=/home/baran/Desktop/kelo_docker/src/kelo_bringup
ExecStart=/usr/bin/python3 -m kelo_bringup.detector_service --backend tensorrt --model /home/baran/Desktop/kelo_docker/data/models/yolox_s.onnx --engine-dir /home/baran/Desktop/kelo_docker/data/models --host 172.17.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
