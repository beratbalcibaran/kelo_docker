# Settings for starting the stack by hand with docker compose.
# Copy to .env in this folder and adapt: cp .env.example .env

# Same domain as the driver on the robot computer.
ROS_DOMAIN_ID=42

# Port of this Jetson connected to the robot computer (see: ip -br link).
KELO_DDS_IFACE=enP8p1s0

# Optional. Without a VNC password the panel generates a random one at every start.
#KELO_VNC_PASSWORD=
#KELO_WEB_PASSWORD=
